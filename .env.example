# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_TOKEN: High-entropy secret token for securing catalog admin routes (`GET`, `POST`, `PUT`, `DELETE` /api/items).
# Include this token as `x-admin-token` header value on any admin request.
ADMIN_TOKEN="elite_admin_secret_999"

# PostgreSQL connection parameters (optional, defaults to Embedded File-Backed Local DB if unconfigured)
PGHOST="localhost"
PGPORT=5432
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="postgres"
# Or a single connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"